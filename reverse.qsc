let x: int = 8576;
let INT_MAX: int = 2147483647;
let INT_MIN: int = -2147483647;
let rev: int = 0;
while(x != 0) {
    let pop: int = x % 10;
    x = x / 10;
    if (rev > INT_MAX / 10 || (rev == INT_MAX / 10 && pop > 7)) {return 0;}
    if (rev < INT_MIN / 10 || (rev == INT_MAX / 10 && pop < -8)) {return 0;}
    rev = rev * 10 + pop;
}
print("%d\n", rev);