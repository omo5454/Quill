let x: number = 4455;
let INT_MAX: number = 2147483647;
let INT_MIN: number = -2147483648;
let rev: number = 0;
while(x != 0) {
    let pop: number = x % 10;
    x = x / 10;
    if (rev > INT_MAX / 10 || (rev == INT_MAX / 10 && pop > 7)) {return 0;}
    if (rev < INT_MIN / 10 || (rev == INT_MAX / 10 && pop < -8)) {return 0;}
    rev = rev * 10 + pop;
}
printf(rev);