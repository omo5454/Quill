let greeting: str = "Hello";
let comma: str = ",";
let space: str = " ";
let ending: str = "world!\n";

let count: int = 5;
let total: int = 0;
let i: int = 0;

printf(greeting + comma + space + ending);

while (i < count) {
    total = total + (i + 1);
    i = i + 1;
    printf("i is: " + i);
    printf("Total is: " + total);
}

if (total == 15) {
    printf("The loop sum is correct\n");
} else {
    printf("The loop sum is wrong\n");
}

printf("This transpiled successfully\n");