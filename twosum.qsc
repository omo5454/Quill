# Two Sum, ported from the classic Python solution.
#
# Quill has no array parameters/return values and no hashmap yet, so
# this can't match the original `def twoSum(nums, target) -> [int]`
# signature. Instead: nums and target are set up inline, and the
# result is printed rather than returned. The O(n) hashmap lookup
# ("seen") is replaced with a nested O(n^2) scan, since there's no
# map type to fall back on.

func twoSum(): string {
    let nums: number[6];
    nums[0] = 2;
    nums[1] = 7;
    nums[2] = 11;
    nums[3] = 15;
    nums[4] = 1;
    nums[5] = 8;

    let target: number = 26;
    let count: number = 6;

    let i: number = 0;
    while i < count {
        let j: number = i + 1;
        while j < count {
            if nums[i] + nums[j] == target {
                return "[" + i + ", " + j + "]";
            }
            j++;
        }
        i++;
    }
    return "no pair found";
}