func Pow(n: number, x: double){
    let N: number = n;
    if(N < 0) {
        x = 1 / x;
        N = -N;
    }

    let res: double = 1.0;
    while(N > 0){
        if(N % 2 == 1) {
            res = res * x;
        }

        x = x * x;
        N = N / 2;
    }
    return res;
}


printf(Pow(3, 16.0));