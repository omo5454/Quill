# ─── Variables ───────────────────────────────────────────────────────────────

let x = 10;
let name = "Quill";
let pi = 3.14;
let greeting = "Hello, " + name;

printf(greeting);
printf("x is: " + x);
printf("pi is: " + pi);

# ─── Reassignment ────────────────────────────────────────────────────────────

let x = 20;
printf("x reassigned to: " + x);

# ─── Arithmetic ──────────────────────────────────────────────────────────────

let add = 10 + 5;
let sub = 10 - 3;
let mul = 6 * 7;
let div = 20 / 4;

printf("10 + 5 = " + add);
printf("10 - 3 = " + sub);
printf("6 * 7 = " + mul);
printf("20 / 4 = " + div);

# ─── Float arithmetic ────────────────────────────────────────────────────────

let radius = 5.0;
let area = pi * radius * radius;
printf("Circle area (approx): " + area);

# ─── String concatenation ────────────────────────────────────────────────────

let first = "Hello";
let second = " World";
let combined = first + second;
printf(combined);

# ─── Booleans ────────────────────────────────────────────────────────────────

let t = True;
let f = False;
printf("True is: " + t);
printf("False is: " + f);

# ─── Comparisons ─────────────────────────────────────────────────────────────

let a = 10;
let b = 20;

if a < b {
    say "a is less than b";
}

if b > a {
    say "b is greater than a";
}

if a == 10 {
    say "a equals 10";
}

if a != b {
    say "a and b are not equal";
}

if b >= 20 {
    say "b is greater than or equal to 20";
}

if a <= 10 {
    say "a is less than or equal to 10";
}

# ─── If / else if / else ─────────────────────────────────────────────────────

let score = 75;

if score >= 90 {
    say "Grade: A";
} else if score >= 75 {
    say "Grade: B";
} else if score >= 60 {
    say "Grade: C";
} else {
    say "Grade: F";
}

# ─── Nested conditionals ─────────────────────────────────────────────────────

let age = 20;
let hasID = True;

if age >= 18 {
    if hasID == 1 {
        say "Entry allowed";
    } else {
        say "No ID, entry denied";
    }
} else {
    say "Too young for entry";
}

# ─── Logical operators ───────────────────────────────────────────────────────

let sunny = True;
let warm = True;

if sunny == 1 && warm == 1 {
    say "Great day for a walk";
}

let raining = False;

if raining == 0 || sunny == 1 {
    say "We can go outside";
}

# ─── While loop ──────────────────────────────────────────────────────────────

let i = 0;
while i < 5 {
    printf("i = " + i);
    let i = i + 1;
}

# ─── Loop accumulator ────────────────────────────────────────────────────────

let sum = 0;
let j = 1;
while j <= 10 {
    let sum = sum + j;
    let j = j + 1;
}
printf("Sum 1 to 10 = " + sum);

# ─── Nested loops ────────────────────────────────────────────────────────────

let outer = 0;
while outer < 3 {
    let inner = 0;
    while inner < 3 {
        printf("outer=" + outer + " inner=" + inner);
        let inner = inner + 1;
    }
    let outer = outer + 1;
}

# ─── Functions ───────────────────────────────────────────────────────────────

func greet(name) {
    printf("Hello, " + name + "!");
}

greet("Alice");
greet("Bob");

# ─── Function with arithmetic ────────────────────────────────────────────────

func square(n) {
    let n2 = n * n;
    printf(n + " squared = " + n2);
}

square(4);
square(9);

# ─── Function with conditional ───────────────────────────────────────────────

func isAdult(age) {
    if age >= 18 {
        say "Is an adult";
    } else {
        say "Is not an adult";
    }
}

isAdult(20);
isAdult(15);

# ─── Function with loop ──────────────────────────────────────────────────────

func countUp(n) {
    let i = 0;
    while i < n {
        printf("count: " + i);
        let i = i + 1;
    }
}

countUp(4);

# ─── Function called multiple times ─────────────────────────────────────────

func double(n) {
    let n2 = n * 2;
    printf(n + " doubled = " + n2);
}

double(3);
double(7);
double(12);

# ─── Standard library ────────────────────────────────────────────────────────

let root = sqrt(144);
printf("sqrt(144) = " + root);

let strLen = len("Quill language");
printf("len of string = " + strLen);

let rnd = random();
printf("random number: " + rnd);

let now = timeNow();
printf("current time: " + now);

# ─── Incrementation ──────────────────────────────────────────────────────────

let counter = 0;
counter++;
counter++;
counter++;
printf("counter after 3 increments: " + counter);

counter--;
printf("counter after decrement: " + counter);

# ─── Comments do not affect execution ────────────────────────────────────────

# this is a comment and should be ignored
let result = 100;
# another comment
printf("result = " + result);

# ─── Return statements early and end ────────────────────────────────────────
func add(a, b) {
    return a + b;
}

let result = add(3, 4);
printf(result);


# early 
func isAdult(age) {
    if age < 18 {
        return "no";
    }
    return "yes";
}

printf(isAdult(20));

# ─── End ─────────────────────────────────────────────────────────────────────
say "All tests complete.";